{
  "name": "clawmuse",
  "version": "1.0.0",
  "description": "ClawMuse — a private AI companion that runs entirely on your own machine.",
  "main": "./out/main/index.js",
  "author": "ClawMuse contributors",
  "homepage": "https://clawmuse.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PSA-Team-source/clawmuse.git"
  },
  "bugs": {
    "url": "https://github.com/PSA-Team-source/clawmuse/issues"
  },
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-native.mjs && electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && node scripts/build-native.mjs && node scripts/vendor-npm.mjs && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:e2e:local": "node scripts/e2e-local.mjs",
    "test:e2e:clean": "node scripts/e2e-clean.mjs",
    "test:e2e:launchd": "node scripts/e2e-launchd.mjs",
    "test:e2e:pairing": "node scripts/e2e-pairing.mjs",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && electron-vite build && npm run check:secrets && npm run test:smoke && npm run test:e2e:pairing && npm run test:e2e:local",
    "verify:packaged": "npm run dist:mac:arm && node scripts/check-bundle-secrets.mjs --app dist/mac-arm64/ClawMuse.app && npm run test:e2e:clean && npm run test:e2e:launchd && node scripts/e2e-local.mjs --app dist/mac-arm64/ClawMuse.app",
    "postinstall": "electron-builder install-app-deps && node scripts/patch-dev-app-name.mjs",
    "pack:dir": "npm run build && node scripts/pack.mjs --dir",
    "dist:mac": "npm run build && node scripts/pack.mjs --mac --arm64 --x64",
    "dist:mac:arm": "npm run build && node scripts/pack.mjs --mac --arm64",
    "dist:win": "npm run build && node scripts/pack.mjs --win --x64 --arm64",
    "dist:win:x64": "npm run build && node scripts/pack.mjs --win --x64",
    "audit:ui": "node scripts/ui-audit.mjs"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.81",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@eslint/js": "^10.0.1",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^28.0.1",
    "motion": "^12.42.2",
    "npm": "11.8.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.171.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "license": "MIT"
}
